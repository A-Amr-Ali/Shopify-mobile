<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}"{% if request.locale.iso_code == 'ar' %} dir="rtl"{% endif %}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#151515">
<link rel="canonical" href="{{ canonical_url }}">
<title>{{ page_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} — {{ current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name | escape }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% else %}<meta name="description" content="{{ shop.description | default: shop.name | escape }}">{% endif %}
{% if request.page_type == 'search' or request.page_type == 'cart' %}<meta name="robots" content="noindex,follow">{% endif %}
{% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:title" content="{{ page_title | escape }}"><meta property="og:description" content="{{ page_description | default: shop.description | escape }}"><meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}"><meta name="twitter:card" content="summary_large_image">{% endif %}
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
{% render 'sf-fonts' %}
{{ 'sofie-atelier.css' | asset_url | stylesheet_tag }}
{{ 'sofie-claude.css' | asset_url | stylesheet_tag }}{{ 'sofie-claude-2.css' | asset_url | stylesheet_tag }}{{ 'sofie-claude-3.css' | asset_url | stylesheet_tag }}{{ 'sofie-claude-4.css' | asset_url | stylesheet_tag }}<script src="{{ 'sofie-claude.js' | asset_url }}" defer></script><script src="{{ 'sofie-now-auto.js' | asset_url }}" defer></script>{%- if request.page_type == 'product' -%}<script src="{{ 'sofie-claude-pdp.js' | asset_url }}" defer></script>{%- endif -%}
{% if template.suffix == 'beauty-room' %}{{ 'sofie-beauty-room.css' | asset_url | stylesheet_tag }}<script src="{{ 'sofie-beauty-room.js' | asset_url }}" defer></script>{% endif %}
{{ content_for_header }}
<script>document.documentElement.classList.replace('no-js','js');</script>
<script src="{{ 'sofie-atelier.js' | asset_url }}" defer></script>
{{ 'sofie-journey.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sofie-journey.js' | asset_url }}" defer></script>
{{ 'sofie-quest-promo.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sofie-quest-promo.js' | asset_url }}" defer></script>
{% if request.page_type == 'index' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}}</script>{% endif %}
</head>
<body data-page="{{ request.page_type }}">
<a class="skip-link" href="#MainContent">{{ 'sf.text.skip' | t }}</a>
{% section 'sf-header' %}
<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
{% section 'sf-footer' %}
{% render 'sf-dialogs' %}
