# ── Sofie Trend Engine — environment ──────────────────────────────────────
# Copy to ".env" for local runs. In production use GitHub Actions secrets.

# Your store domain (the *.myshopify.com one, NOT the public www domain)
SHOPIFY_STORE=a45545-2.myshopify.com

# Admin API access token from a CUSTOM APP (see README "Setup" step 1).
# Needs scopes: read_products, write_products  (+ read_orders for sales velocity)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin API version
SHOPIFY_API_VERSION=2024-10

# ── Behaviour ─────────────────────────────────────────────────────────────
# Google Trends geo (EG = Egypt). Use "" for worldwide.
TREND_GEO=EG

# Tag the engine manages for the Trending collection.
TREND_TAG=trending
# Tag for best sellers (optional; Shopify "Best selling" sort is usually enough).
BESTSELLER_TAG=bestseller

# How many products to keep tagged as trending at any time.
MAX_TRENDING=12
MAX_BESTSELLERS=12

# Blend weights (0..1). They are normalised internally; relative size is what matters.
WEIGHT_GOOGLE=0.5
WEIGHT_SALES=0.4
WEIGHT_MANUAL=0.6

# Sales-velocity lookback in days (needs read_orders scope).
SALES_LOOKBACK_DAYS=14

# Set DRY_RUN=true to compute & print without writing any tags (safe testing).
DRY_RUN=false
