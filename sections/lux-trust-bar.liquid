{%- comment -%}
  Sofie — Premium Trust Section (under hero). 5 elegant pillars.
  Reduces purchase hesitation for high-ticket authentic makeup.
{%- endcomment -%}
{{ 'sofie-luxury.css' | asset_url | stylesheet_tag }}

<section class="sofie sofie__section {% if section.settings.tint %}sofie__section--tint{% endif %}" aria-label="Why shop with Sofie">
  <div class="sofie__container">
    {%- if section.settings.heading != blank -%}
      <div class="sofie__head sofie__head--center sofie-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="sofie__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2 class="sofie__h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="sofie-trust__grid sofie-reveal">
      {%- for block in section.blocks -%}
        <div class="sofie-trust__item" {{ block.shopify_attributes }}>
          <span class="sofie-trust__icon">{% render 'lux-icon', name: block.settings.icon %}</span>
          <h3 class="sofie-trust__title">{{ block.settings.title | escape }}</h3>
          <p class="sofie-trust__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lux Trust Bar",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Sofie Standard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Sofie's Makeup Store" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Trust pillar",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            {"value":"shield","label":"Shield"},
            {"value":"badge","label":"Authenticity badge"},
            {"value":"store","label":"Store"},
            {"value":"lock","label":"Secure lock"},
            {"value":"truck","label":"Delivery"},
            {"value":"gift","label":"Gift"},
            {"value":"leaf","label":"Leaf"},
            {"value":"sparkle","label":"Sparkle"}
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Authentic" },
        { "type": "text", "id": "text", "label": "Text", "default": "Sourced from official brands & authorized distributors." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{
    "name": "Lux Trust Bar",
    "blocks": [
      { "type": "pillar", "settings": { "icon": "badge", "title": "100% Authentic Products", "text": "Every item sourced from official brands & authorized distributors." } },
      { "type": "pillar", "settings": { "icon": "sparkle", "title": "10+ Years Beauty Expertise", "text": "A decade of curating prestige beauty for Egypt." } },
      { "type": "pillar", "settings": { "icon": "store", "title": "Trusted Beauty Destination", "text": "Boutiques at Marassi M-Porium & Akti by Zahra." } },
      { "type": "pillar", "settings": { "icon": "lock", "title": "Secure Payments", "text": "Protected checkout. Pay your way, with confidence." } },
      { "type": "pillar", "settings": { "icon": "truck", "title": "Fast Nationwide Delivery", "text": "Delivered with care to every governorate in Egypt." } }
    ]
  }]
}
{% endschema %}
