{% doc %}
  Renders the time-limited SOFIE Christmas layer, ending 8 January 2027 at 00:00 Cairo.
  @param {string} placement - One of head, body, logo or footer.
{% enddoc %}
{%- liquid
  assign festive_now = 'now' | date: '%s' | plus: 0
  assign festive_start = 1793570400
  assign festive_end = 1799359200
  assign festive_enabled = false
  if settings.sf_christmas_enabled != false and festive_now >= festive_start and festive_now < festive_end
    assign festive_enabled = true
  endif
-%}
{%- if festive_enabled -%}
  {%- case placement -%}
    {%- when 'head' -%}
      <link id="sf-christmas-styles" rel="stylesheet" href="{{ 'sofie-christmas-2026.css' | asset_url }}">
      <script>if(Date.now()>=1793570400000&&Date.now()<1799359200000){document.documentElement.setAttribute('data-sf-christmas','active');}</script>
      <script id="sf-christmas-config" type="application/json">{"startsAt":1793570400000,"expiresAt":1799359200000,"snow":{% if settings.sf_christmas_snow == false %}false{% else %}true{% endif %},"strings":{"pause":{{ 'sf.christmas.pause' | t | json }},"resume":{{ 'sf.christmas.resume' | t | json }},"reduced":{{ 'sf.christmas.reduced' | t | json }}}}</script>
      <script src="{{ 'sofie-christmas-2026.js' | asset_url }}" defer></script>
    {%- when 'logo' -%}
      <span class="sf-xmas-logo sf-xmas-fragment" data-sf-festive aria-hidden="true"><span class="sf-xmas-logo__flight sf-xmas-motion">{% render 'sofie-christmas-icon', name: 'sleigh' %}</span><span class="sf-xmas-logo__trail"></span></span>
    {%- when 'body' -%}
      {%- liquid
        assign festive_all = routes.collections_url | append: '/all'
        assign festive_gifts = collections['christmas-at-sofie-gift-bundles']
        if festive_gifts.products_count == 0 or festive_gifts == blank
          assign festive_gifts = collections['value-gift-sets']
        endif
        assign festive_minis = collections['mini-size']
        assign festive_home_gifts = collections['home-meets-beauty-christmas-gift-bundles']
        assign festive_home_world = false
        if request.page_type == 'page' and page.handle == 'sofies-home' and festive_home_gifts.products_count > 0
          assign festive_home_world = true
        endif
        assign festive_gift_url = festive_all
        assign festive_mini_url = festive_all
        if festive_gifts.products_count > 0
          assign festive_gift_url = festive_gifts.url
        endif
        if festive_minis.products_count > 0
          assign festive_mini_url = festive_minis.url
        endif
        assign festive_ribbon_url = festive_gift_url
        if festive_home_world
          assign festive_ribbon_url = festive_home_gifts.url
        endif
        assign festive_hero = false
        if request.page_type == 'index'
          assign festive_hero = true
        elsif request.page_type == 'page'
          if page.handle == 'sofies-makeup' or page.handle == 'sofies-home'
            assign festive_hero = true
          endif
        endif
      -%}
      <div class="sf-xmas-ribbon sf-xmas-fragment" data-sf-festive>
        <a href="{{ festive_ribbon_url }}">{% render 'sofie-christmas-icon', name: 'gift' %}<span>{{ 'sf.christmas.ribbon' | t }}</span><span class="sf-xmas-ribbon__arrow" aria-hidden="true">↗</span></a>
        <button type="button" class="sf-xmas-toggle" data-sf-festive-toggle aria-pressed="false"><span aria-hidden="true">❄</span><span data-sf-festive-toggle-label>{{ 'sf.christmas.pause' | t }}</span></button>
      </div>
      {%- if festive_home_world -%}
        {% render 'sf-home-beauty-gifts', gift_collection: festive_home_gifts %}
      {%- elsif festive_hero -%}
        <section class="sf-xmas-hero sf-xmas-fragment" data-sf-festive aria-labelledby="sf-xmas-title">
          <div class="sf-xmas-hero__copy">
            <p class="sf-xmas-eyebrow">{{ 'sf.christmas.eyebrow' | t }}</p>
            <h2 id="sf-xmas-title">{{ 'sf.christmas.title_first' | t }}<br><em>{{ 'sf.christmas.title_last' | t }}</em></h2>
            <p class="sf-xmas-hero__text">{{ 'sf.christmas.description' | t }}</p>
            <div class="sf-xmas-hero__actions"><a class="sf-xmas-button" href="{{ festive_gift_url }}">{{ 'sf.christmas.shop_gifts' | t }}<span aria-hidden="true">↗</span></a><a class="sf-xmas-link" href="{{ festive_mini_url }}">{{ 'sf.christmas.shop_minis' | t }}<span aria-hidden="true">↗</span></a></div>
            {%- if festive_gifts.handle == 'christmas-at-sofie-gift-bundles' and festive_gifts.products_count > 0 -%}
              {%- assign festive_gift_image = festive_gifts.image | default: festive_gifts.products.first.featured_image -%}
              {%- assign festive_starting_price = festive_gifts.products | map: 'price' | sort | first | money -%}
              <a class="sf-xmas-bundles" href="{{ festive_gift_url }}" data-sf-gift-bundles>
                {%- if festive_gift_image -%}{{ festive_gift_image | image_url: width: 180 | image_tag: width: 84, height: 84, loading: 'lazy', alt: '' }}{%- endif -%}
                <span class="sf-xmas-bundles__copy"><strong>{{ 'sf.christmas.bundle_title' | t }}</strong><span>{{ 'sf.christmas.bundle_text' | t }}</span><span class="sf-xmas-bundles__cta">{{ 'sf.christmas.bundle_cta' | t }} · {{ 'sf.christmas.bundle_from' | t: price: festive_starting_price }}</span></span><span aria-hidden="true">↗</span>
              </a>
            {%- endif -%}
            {%- if request.page_type == 'index' and festive_home_gifts.products_count > 0 -%}
              <a class="sf-xmas-bundles sf-xmas-bundles--home" href="{{ festive_home_gifts.url }}" data-sf-home-beauty-entry>
                {% render 'sf-gift-original-photos', gift_product: festive_home_gifts.products.first, size: 'compact' %}
                <span class="sf-xmas-bundles__copy"><strong>{{ 'sf.christmas.home_title' | t }}</strong><span>{{ 'sf.christmas.home_entry_text' | t }}</span><span class="sf-xmas-bundles__cta">{{ 'sf.christmas.home_cta' | t }}</span></span><span aria-hidden="true">↗</span>
              </a>
            {%- endif -%}
            <p class="sf-xmas-hero__signature">{{ 'sf.christmas.signature' | t }}</p>
          </div>
          <div class="sf-xmas-scene" aria-hidden="true">
            <div class="sf-xmas-scene__arch"></div><div class="sf-xmas-scene__ring"></div>
            <span class="sf-xmas-scene__star sf-xmas-scene__star--one sf-xmas-motion">{% render 'sofie-christmas-icon', name: 'star' %}</span><span class="sf-xmas-scene__star sf-xmas-scene__star--two sf-xmas-motion">{% render 'sofie-christmas-icon', name: 'star' %}</span><span class="sf-xmas-scene__star sf-xmas-scene__star--three">{% render 'sofie-christmas-icon', name: 'star' %}</span>
            <div class="sf-xmas-scene__sleigh sf-xmas-motion">{% render 'sofie-christmas-icon', name: 'sleigh' %}</div>
            <div class="sf-xmas-scene__tree">{% render 'sofie-christmas-icon', name: 'tree' %}</div>
            <div class="sf-xmas-present sf-xmas-present--cream"><span class="sf-xmas-present__bow"></span><span class="sf-xmas-present__lid"></span><span class="sf-xmas-present__tag">SOFIE</span></div>
            <div class="sf-xmas-present sf-xmas-present--berry"><span class="sf-xmas-present__bow"></span><span class="sf-xmas-present__lid"></span></div>
            <div class="sf-xmas-present sf-xmas-present--sage"><span class="sf-xmas-present__bow"></span><span class="sf-xmas-present__lid"></span></div>
            <span class="sf-xmas-scene__caption">{{ 'sf.christmas.scene_caption' | t }}</span>
          </div>
        </section>
      {%- endif -%}
      <div class="sf-xmas-snow sf-xmas-fragment" data-sf-festive data-sf-festive-snow aria-hidden="true"></div>
    {%- when 'footer' -%}
      <div class="sf-xmas-signoff sf-xmas-fragment" data-sf-festive><span class="sf-xmas-signoff__sprig" aria-hidden="true">{% render 'sofie-christmas-icon', name: 'sprig' %}</span><p>{{ 'sf.christmas.signoff' | t }}</p><span class="sf-xmas-signoff__sleigh sf-xmas-motion" aria-hidden="true">{% render 'sofie-christmas-icon', name: 'sleigh' %}</span></div>
  {%- endcase -%}
{%- endif -%}

