{%- comment -%}
  Sofie Rewards — public marketing teaser. Shows to EVERYONE (logged in or not)
  to promote the loyalty program and drive sign-ups. Fully clickable to the
  rewards/registration page. All text, colors, and the link are editable in the
  theme editor.
{%- endcomment -%}

{%- liquid
  assign link = block.settings.link | default: '/pages/sofie-rewards'
  if customer and block.settings.member_link != blank
    assign link = block.settings.member_link
  endif
  assign cta = block.settings.cta_label
  if customer and block.settings.member_cta != blank
    assign cta = block.settings.member_cta
  endif
-%}

<div class="sofie-teaser sofie-teaser--{{ block.settings.align }}"
     style="--teaser-bg: {{ block.settings.bg_color }}; --teaser-fg: {{ block.settings.text_color }}; --teaser-accent: {{ block.settings.accent_color }};">
  <a class="sofie-teaser__link" href="{{ link }}" aria-label="{{ block.settings.heading | escape }}">
    <div class="sofie-teaser__inner">
      {%- if block.settings.eyebrow != blank -%}
        <span class="sofie-teaser__eyebrow">{{ block.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if block.settings.heading != blank -%}
        <h2 class="sofie-teaser__title">{{ block.settings.heading }}</h2>
      {%- endif -%}
      {%- if block.settings.subheading != blank -%}
        <p class="sofie-teaser__sub">{{ block.settings.subheading }}</p>
      {%- endif -%}
      {%- if cta != blank -%}
        <span class="sofie-teaser__btn">{{ cta }}</span>
      {%- endif -%}
    </div>
  </a>
</div>

{{ 'loyalty-teaser.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Sofie Rewards Teaser",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Message" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sofie Rewards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Earn points on every order" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Join free and collect points on purchases, reviews & referrals — then redeem them for EGP off your favourites." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button text (visitors)", "default": "Learn More & Join Free" },
    { "type": "url", "id": "link", "label": "Link (visitors)", "info": "Where visitors go — e.g. /pages/sofie-rewards so they can learn before signing up" },
    { "type": "text", "id": "member_cta", "label": "Button text (logged-in)", "default": "View your rewards" },
    { "type": "url", "id": "member_link", "label": "Link (logged-in)", "info": "Where signed-in customers go — e.g. /account" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#2a201d" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Button", "default": "#c9a96a" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] }
  ]
}
{% endschema %}
