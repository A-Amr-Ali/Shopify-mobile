{%- comment -%}
  Sofie's Loyalty dashboard — app block for the Kalles account area.
  Add it to the customer account page (or any section that accepts app blocks).
  All data is fetched client-side from the App Proxy (/apps/loyalty/me); the
  proxy verifies the logged-in customer via signed HMAC, so no IDs are trusted
  from the browser. Renders nothing for logged-out visitors.
{%- endcomment -%}

{%- if customer -%}
  <div
    id="sofie-loyalty"
    class="sofie-loyalty"
    data-proxy="{{ block.settings.proxy_base }}"
    data-currency="{{ block.settings.currency }}">
    <div class="sofie-loyalty__head">
      <span class="sofie-loyalty__eyebrow">{{ block.settings.eyebrow }}</span>
      <h2 class="sofie-loyalty__title">{{ block.settings.heading }}</h2>
    </div>

    <div class="sofie-loyalty__grid" data-state="loading">
      <div class="sofie-loyalty__card sofie-loyalty__balance">
        <span class="sofie-loyalty__label">Your points</span>
        <strong class="sofie-loyalty__points" data-points>—</strong>
        <span class="sofie-loyalty__tier" data-tier></span>
      </div>

      <div class="sofie-loyalty__card sofie-loyalty__progress">
        <span class="sofie-loyalty__label" data-progress-label>Tier progress</span>
        <div class="sofie-loyalty__bar"><span data-progress-fill style="width:0%"></span></div>
        <small data-progress-note></small>
      </div>
    </div>

    <div class="sofie-loyalty__rewards" data-rewards hidden>
      <h3 class="sofie-loyalty__subhead">{{ block.settings.rewards_heading }}</h3>
      <div class="sofie-loyalty__reward-list" data-reward-list></div>
      <p class="sofie-loyalty__msg" data-msg role="status"></p>
    </div>

    <noscript>Enable JavaScript to view your loyalty rewards.</noscript>
  </div>

  {{ 'loyalty-dashboard.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'loyalty-dashboard.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Loyalty Dashboard",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Loyalty Dashboard" },
    { "type": "text", "id": "proxy_base", "label": "App Proxy base", "default": "/apps/loyalty" },
    { "type": "text", "id": "currency", "label": "Currency suffix", "default": "EGP" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sofie Rewards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Loyalty" },
    { "type": "text", "id": "rewards_heading", "label": "Rewards heading", "default": "Redeem your points" }
  ]
}
{% endschema %}
