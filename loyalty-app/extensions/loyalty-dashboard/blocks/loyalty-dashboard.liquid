{%- comment -%}
  Sofie's Loyalty + Beauty Profile hub — app block for the My Rewards page.
  Shows: greeting, points + tier + progress, redeemable rewards, the customer's
  beauty profile (shade/skin/undertone/products), personalized tips, and recent
  orders. Live data comes from the App Proxy (/apps/loyalty/me); orders + name
  come from Liquid. Renders nothing for logged-out visitors.
{%- endcomment -%}

{%- if customer -%}
  <div
    id="sofie-loyalty"
    class="sofie-loyalty"
    data-proxy="{{ block.settings.proxy_base }}"
    data-currency="{{ block.settings.currency }}">

    <div class="sofie-loyalty__head">
      <span class="sofie-loyalty__eyebrow">{{ block.settings.eyebrow }}</span>
      <h2 class="sofie-loyalty__title">
        {%- if customer.first_name != blank -%}{{ block.settings.heading }}, {{ customer.first_name }}{%- else -%}{{ block.settings.heading }}{%- endif -%}
      </h2>
    </div>

    <div class="sofie-loyalty__grid" data-state="loading">
      <div class="sofie-loyalty__card sofie-loyalty__balance">
        <span class="sofie-loyalty__label">Your points</span>
        <strong class="sofie-loyalty__points" data-points>—</strong>
        <span class="sofie-loyalty__tier" data-tier></span>
      </div>

      <div class="sofie-loyalty__card sofie-loyalty__progress">
        <span class="sofie-loyalty__label" data-progress-label>Tier progress</span>
        <div class="sofie-loyalty__bar"><span data-progress-fill style="width:0%"></span></div>
        <small data-progress-note></small>
      </div>
    </div>

    <div class="sofie-loyalty__rewards" data-rewards hidden>
      <h3 class="sofie-loyalty__subhead">{{ block.settings.rewards_heading }}</h3>
      <div class="sofie-loyalty__reward-list" data-reward-list></div>
      <div class="sofie-loyalty__gifts" data-gifts hidden>
        <h4 class="sofie-loyalty__gift-head">{{ block.settings.gifts_heading }}</h4>
        <div class="sofie-loyalty__gift-list" data-gift-list></div>
      </div>
      <p class="sofie-loyalty__msg" data-msg role="status"></p>
    </div>

    <div class="sofie-loyalty__reco" data-reco hidden>
      <h3 class="sofie-loyalty__subhead">{{ block.settings.reco_heading }}</h3>
      <div class="sofie-loyalty__reco-list" data-reco-list></div>
    </div>

    <div class="sofie-loyalty__profile" data-profile-card hidden>
      <h3 class="sofie-loyalty__subhead">{{ block.settings.profile_heading }}</h3>
      <dl class="sofie-loyalty__profile-grid" data-profile-grid></dl>
    </div>

    <div class="sofie-loyalty__tips" data-tips hidden>
      <h3 class="sofie-loyalty__subhead">{{ block.settings.tips_heading }}</h3>
      <p class="sofie-loyalty__nudge" data-tips-nudge hidden></p>
      <div class="sofie-loyalty__tips-list" data-tips-list></div>
    </div>

    {%- if block.settings.show_orders and customer.orders.size > 0 -%}
      <div class="sofie-loyalty__orders">
        <h3 class="sofie-loyalty__subhead">{{ block.settings.orders_heading }}</h3>
        <ul class="sofie-loyalty__order-list">
          {%- for order in customer.orders limit: 5 -%}
            <li class="sofie-loyalty__order">
              <a class="sofie-loyalty__order-no" href="{{ order.customer_url }}">#{{ order.order_number }}</a>
              <span class="sofie-loyalty__order-date">{{ order.created_at | date: "%b %d, %Y" }}</span>
              <span class="sofie-loyalty__order-total">{{ order.total_price | money }}</span>
              <span class="sofie-loyalty__order-status">{{ order.financial_status_label }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <noscript>Enable JavaScript to view your loyalty rewards.</noscript>
  </div>

  {{ 'loyalty-dashboard.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'loyalty-dashboard.js' | asset_url }}" defer></script>
{%- else -%}
  <div class="sofie-loyalty sofie-loyalty--guest">
    <span class="sofie-loyalty__eyebrow">{{ block.settings.eyebrow }}</span>
    <h2 class="sofie-loyalty__title">{{ block.settings.guest_heading }}</h2>
    <p class="sofie-loyalty__guest-sub">{{ block.settings.guest_text }}</p>
    <a class="sofie-loyalty__guest-btn" href="{{ block.settings.guest_link | default: '/account' }}">{{ block.settings.guest_cta }}</a>
  </div>
  {{ 'loyalty-dashboard.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Loyalty Dashboard",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Loyalty Dashboard" },
    { "type": "text", "id": "proxy_base", "label": "App Proxy base", "default": "/apps/loyalty" },
    { "type": "text", "id": "currency", "label": "Currency suffix", "default": "EGP" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sofie Rewards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome back" },
    { "type": "text", "id": "rewards_heading", "label": "Rewards heading", "default": "Redeem your points" },
    { "type": "text", "id": "gifts_heading", "label": "Gifts heading", "default": "Or redeem for a free gift" },
    { "type": "text", "id": "reco_heading", "label": "Recommendations heading", "default": "Recommended for your routine" },
    { "type": "text", "id": "profile_heading", "label": "Profile heading", "default": "Your beauty profile" },
    { "type": "text", "id": "tips_heading", "label": "Tips heading", "default": "Your personalized beauty tips" },
    { "type": "checkbox", "id": "show_orders", "label": "Show recent orders", "default": true },
    { "type": "text", "id": "orders_heading", "label": "Orders heading", "default": "Recent orders" },
    { "type": "header", "content": "Logged-out visitors" },
    { "type": "text", "id": "guest_heading", "label": "Guest heading", "default": "Join Sofie Rewards" },
    { "type": "textarea", "id": "guest_text", "label": "Guest text", "default": "Sign in or create a free account to earn points on every order, take your beauty profile quiz, and redeem points for EGP off." },
    { "type": "text", "id": "guest_cta", "label": "Guest button", "default": "Sign in to start earning" },
    { "type": "url", "id": "guest_link", "label": "Guest button link", "info": "Usually /account" }
  ]
}
{% endschema %}
