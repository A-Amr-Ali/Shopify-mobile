{%- comment -%}
  Sofie's Beauty Profile quiz — app block. Posts answers to the App Proxy
  (/apps/loyalty/quiz), which awards 250 points once and builds tips. Renders
  nothing for logged-out visitors.
{%- endcomment -%}

{%- if customer -%}
  <div id="sofie-quiz" class="sofie-quiz" data-proxy="{{ block.settings.proxy_base }}">
    <div class="sofie-quiz__head">
      <span class="sofie-quiz__eyebrow">{{ block.settings.eyebrow }}</span>
      <h2 class="sofie-quiz__title">{{ block.settings.heading }}</h2>
      <p class="sofie-quiz__sub">{{ block.settings.subheading }}</p>
    </div>

    <form class="sofie-quiz__form" data-quiz-form>
      <label>Skin type
        <select name="skin_type" required>
          <option value="">Choose…</option>
          <option value="dry">Dry</option>
          <option value="oily">Oily</option>
          <option value="combo">Combination</option>
          <option value="normal">Normal</option>
          <option value="sensitive">Sensitive</option>
        </select>
      </label>

      <label>Undertone
        <select name="undertone" required>
          <option value="">Choose…</option>
          <option value="warm">Warm</option>
          <option value="cool">Cool</option>
          <option value="neutral">Neutral</option>
        </select>
      </label>

      <label>Preferred lip finish
        <select name="lip_finish_pref">
          <option value="">Choose…</option>
          <option value="matte">Matte</option>
          <option value="satin">Satin</option>
          <option value="glossy">Glossy</option>
          <option value="dewy">Dewy</option>
        </select>
      </label>

      <label>Foundation shade (optional)
        <input type="text" name="foundation_shade" placeholder="e.g. 230 Warm" maxlength="40">
      </label>

      <fieldset class="sofie-quiz__concerns">
        <legend>Skin concerns</legend>
        {%- assign concerns = "Acne,Dryness,Dark spots,Large pores,Redness,Fine lines,Dullness" | split: "," -%}
        {%- for c in concerns -%}
          <label class="sofie-quiz__chk"><input type="checkbox" name="skin_concerns" value="{{ c }}"> {{ c }}</label>
        {%- endfor -%}
      </fieldset>

      <button type="submit" class="sofie-quiz__btn">{{ block.settings.cta }}</button>
      <p class="sofie-quiz__msg" data-quiz-msg role="status"></p>
    </form>
  </div>

  {{ 'loyalty-quiz.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'loyalty-quiz.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Beauty Profile Quiz",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Beauty Profile Quiz" },
    { "type": "text", "id": "proxy_base", "label": "App Proxy base", "default": "/apps/loyalty" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Earn 250 points" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Beauty Profile" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tell us about your skin and we will tailor recommendations just for you." },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Save & earn 250 points" }
  ]
}
{% endschema %}
