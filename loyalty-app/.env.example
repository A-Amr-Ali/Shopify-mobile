# ── Shopify app ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://loyalty.sofiestore.net
SCOPES=read_customers,write_customers,read_orders,write_discounts,read_products

# App Proxy shared secret is SHOPIFY_API_SECRET (same value Shopify signs with).

# ── Supabase ──
SUPABASE_URL=
# Service-role key — server-side ONLY, never exposed to the storefront.
SUPABASE_SERVICE_ROLE_KEY=

# ── Klaviyo (events push for email flows) ──
KLAVIYO_API_KEY=

# ── Optional: Anthropic (Phase 3 tips engine) ──
# Tips are rules-based by default; set TIPS_USE_CLAUDE=true to enhance with Claude.
ANTHROPIC_API_KEY=
TIPS_USE_CLAUDE=false
# Defaults to claude-opus-4-8; set claude-haiku-4-5 to cut cost on this volume path.
ANTHROPIC_MODEL=claude-opus-4-8

# ── Phase 3 background jobs (crons) + Judge.me ──
# Shop domain used by crons + the Judge.me webhook to get an offline admin client.
SHOP_DOMAIN=sofiestore.myshopify.com
# Shared secret protecting /jobs/* (send as the x-cron-key header).
CRON_KEY=
# Shared secret for the Judge.me review webhook (?token= or x-judgeme-token header).
JUDGEME_WEBHOOK_SECRET=
# Friend's welcome discount minted on referral (whole EGP).
REFERRAL_WELCOME_EGP=200

# Store currency assumptions
LOYALTY_CURRENCY=EGP

# Staff console (/staff) password — staff enter this to look up + redeem in-store.
# Also gates the AI Sales Agent review console (/staff/agent).
STAFF_KEY=

# ── Phase 4: AI Sales Agent ──
# Generates personalised, on-brand outreach from behaviour (abandoned cart,
# views, purchase history). Runs as the /jobs/agent-run cron (x-cron-key).
# Model defaults to AGENT_MODEL → ANTHROPIC_MODEL → claude-opus-4-8.
AGENT_MODEL=
# OFF by default: messages are saved as DRAFTS for review at /staff/agent.
# Set true ONLY after you've tested the voice and trust the guardrails.
AGENT_AUTOSEND=false
# Safety caps.
AGENT_MAX_PER_RUN=25
AGENT_MIN_DAYS_BETWEEN=5
# Trigger tuning (hours/days).
AGENT_ABANDON_HOURS=4
AGENT_BROWSE_MIN_VIEWS=3
AGENT_BROWSE_WINDOW_DAYS=7
AGENT_POST_PURCHASE_DAYS=7
AGENT_WINBACK_DAYS=90
# The Klaviyo metric the dispatcher fires; your Email + WhatsApp Flow triggers on it.
AGENT_KLAVIYO_METRIC=Sofie AI Agent Message
