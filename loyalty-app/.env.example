# ── Shopify app ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://loyalty.sofiestore.net
SCOPES=read_customers,write_customers,read_orders,write_discounts,read_products

# App Proxy shared secret is SHOPIFY_API_SECRET (same value Shopify signs with).

# ── Supabase ──
SUPABASE_URL=
# Service-role key — server-side ONLY, never exposed to the storefront.
SUPABASE_SERVICE_ROLE_KEY=

# ── Klaviyo (Phase 1: events push only) ──
KLAVIYO_API_KEY=

# ── Optional: Anthropic (Phase 3 tips engine) ──
ANTHROPIC_API_KEY=

# Store currency assumptions
LOYALTY_CURRENCY=EGP
