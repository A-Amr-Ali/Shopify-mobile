{%- comment -%}
  Sofie luxury icon set (inline SVG, currentColor).
  Usage:  render 'lux-icon', name: 'shield'
          render 'lux-icon', name: 'truck', size: 32
  Valid names: shield, badge, store, lock, truck, sparkle, leaf, gift, star, instagram, arrow
  Notes:
   - Create this as snippet named exactly "lux-icon" (Shopify adds .liquid).
   - Icons inherit text color (currentColor) and have a built-in default size
     so they render even if the theme CSS doesn't size them.
{%- endcomment -%}
{%- liquid
  assign n = name | default: 'sparkle'
  assign s = size | default: 24
-%}
{%- capture svg_open -%}<svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:middle">{%- endcapture -%}
{%- case n -%}
  {%- when 'shield' -%}
    {{ svg_open }}<path d="M12 2l8 3v6c0 5-3.4 8.5-8 11-4.6-2.5-8-6-8-11V5l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
  {%- when 'badge' -%}
    {{ svg_open }}<circle cx="12" cy="9" r="6"/><path d="M9 14l-1.5 7L12 19l4.5 2L15 14"/><path d="M9.5 9l1.7 1.7L15 7"/></svg>
  {%- when 'store' -%}
    {{ svg_open }}<path d="M3 9l1.5-5h15L21 9"/><path d="M4 9v10h16V9"/><path d="M3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0"/><path d="M9 19v-5h6v5"/></svg>
  {%- when 'lock' -%}
    {{ svg_open }}<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/><circle cx="12" cy="15.5" r="1.4"/></svg>
  {%- when 'truck' -%}
    {{ svg_open }}<path d="M2 6h11v10H2z"/><path d="M13 9h4l4 4v3h-8z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
  {%- when 'leaf' -%}
    {{ svg_open }}<path d="M20 4S9 4 6 11c-2 5 1 9 1 9s8 1 11-6c2-5 2-10 2-10z"/><path d="M7 20s2-9 9-12"/></svg>
  {%- when 'gift' -%}
    {{ svg_open }}<rect x="3" y="8" width="18" height="13" rx="1"/><path d="M3 12h18M12 8v13"/><path d="M12 8S10 3 7.5 4 9 8 12 8zM12 8s2-5 4.5-4S15 8 12 8z"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:middle"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.8 5.9 20.4l1.5-6.8L2.2 9l6.9-.7z"/></svg>
  {%- when 'instagram' -%}
    {{ svg_open }}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'arrow' -%}
    {{ svg_open }}<path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- else -%}
    {{ svg_open }}<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/></svg>
{%- endcase -%}
