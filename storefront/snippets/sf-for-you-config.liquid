{% doc %}
  Configures SOFIE recommendations without exposing customer identity.
{% enddoc %}
<script type="application/json" id="sf-for-you-config">
{"api":"https://sofie-growth-production.up.railway.app","root":{{ routes.root_url | json }},"locale":{{ request.locale.iso_code | json }},"variant":{{ product.selected_or_first_available_variant.id | append: '' | json }},"strings":{
