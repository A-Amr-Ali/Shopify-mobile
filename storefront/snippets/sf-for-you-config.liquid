  "privacy_loading":{{ 'sf.for_you.privacy_loading' | t | json }},
  "dismiss":{{ 'sf.for_you.dismiss' | t | json }},
  "interests":{{ 'sf.for_you.interests' | t | json }},
  "discover":{{ 'sf.for_you.discover' | t | json }},
  "explore":{{ 'sf.for_you.explore' | t | json }}
}}
</script>
{{ 'sofie-for-you.css' | asset_url | stylesheet_tag }}
