{% doc %}
Customer address form fields
@param {form} form - Address form
@param {string} id - Unique form suffix
{% enddoc %}
<div data-address-form><label for="af-{{ id }}">{{ 'sf.text.first_name' | t }}</label><input id="af-{{ id }}" name="address[first_name]" autocomplete="given-name" value="{{ form.first_name | escape }}"><label for="al-{{ id }}">{{ 'sf.text.last_name' | t }}</label><input id="al-{{ id }}" name="address[last_name]" autocomplete="family-name" value="{{ form.last_name | escape }}"><label for="a1-{{ id }}">{{ 'sf.text.address1' | t }}</label><input id="a1-{{ id }}" name="address[address1]" autocomplete="address-line1" value="{{ form.address1 | escape }}"><label for="a2-{{ id }}">{{ 'sf.text.address2' | t }}</label><input id="a2-{{ id }}" name="address[address2]" autocomplete="address-line2" value="{{ form.address2 | escape }}"><label for="ac-{{ id }}">{{ 'sf.text.city' | t }}</label><input id="ac-{{ id }}" name="address[city]" autocomplete="address-level2" value="{{ form.city | escape }}"><label for="country-{{ id }}">{{ 'sf.text.country' | t }}</label><select id="country-{{ id }}" name="address[country]" data-address-country data-default="{{ form.country | escape }}" autocomplete="country">{{ all_country_option_tags }}</select><div data-province-wrap><label for="province-{{ id }}">{{ 'sf.text.province' | t }}</label><select id="province-{{ id }}" name="address[province]" data-address-province data-default="{{ form.province | escape }}" autocomplete="address-level1"></select></div><label for="az-{{ id }}">{{ 'sf.text.zip' | t }}</label><input id="az-{{ id }}" name="address[zip]" autocomplete="postal-code" value="{{ form.zip | escape }}"><label for="ap-{{ id }}">{{ 'sf.text.phone' | t }}</label><input id="ap-{{ id }}" name="address[phone]" type="tel" autocomplete="tel" value="{{ form.phone | escape }}"><label class="sf-check">{{ form.set_as_default_checkbox }} {{ 'sf.text.address_default' | t }}</label></div>

