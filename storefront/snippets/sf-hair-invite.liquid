{% doc %}
Hair Match entry point for the SOFIE hair collections.
{% enddoc %}
<aside class="sfhair-invite"><div><p class="eyebrow">{{ 'sf.hair.teaser_kicker' | t }}</p><h2>{{ 'sf.hair.teaser_heading' | t }}</h2><p>{{ 'sf.hair.teaser_copy' | t }}</p></div><a class="button" href="{{ routes.root_url }}collections/all-hair?view=hair-match">{{ 'sf.hair.teaser_button' | t }} ↗</a></aside>
{% stylesheet %}
.sfhair-invite{display:flex;align-items:center;justify-content:space-between;gap:25px;margin:20px 0 30px;padding:25px;background:#f5f3ed;border:1px solid #ded8ce}.sfhair-invite h2{font-size:27px;margin:7px 0 12px}.sfhair-invite p{max-width:650px;line-height:1.7;font-size:13px}.sfhair-invite .button{white-space:nowrap}@media(max-width:700px){.sfhair-invite{align-items:start;flex-direction:column;padding:21px}}
{% endstylesheet %}
