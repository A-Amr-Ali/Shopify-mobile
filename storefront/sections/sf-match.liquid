<section class="sf-match-teaser sf-wrap" id="sfm" data-match-teaser>
<div class="sf-match-copy">
<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
<h2>{{ section.settings.heading | escape }}</h2>
<p>{{ section.settings.text | escape }}</p>
<div class="sf-match-actions"><button type="button" class="button" data-match-open>{{ section.settings.button_label | escape }} {% render 'sf-icon',name:'arrow' %}</button><span class="sf-match-time">{% render 'sf-icon',name:'clock' %}{{ section.settings.time_label | escape }}</span></div>
<p class="sf-match-resume" data-match-resume hidden><span data-match-resume-text></span> <button type="button" class="underlined" data-match-open="resume">{{ section.settings.resume_label | escape }}</button></p>
</div>
<div class="sf-match-journeys" role="list">
{%- assign journeys = 'base|Complexion|Foundation, skin tint & concealer — with shades to try~skin|Skincare routine|A step-by-step routine for your skin and concerns~scent|Signature scent|Perfumes and mists by the notes you love~lips|Lips & cheeks|Gloss, oils, tints and blush in your colour story~hair|Hair ritual|Care and styling for your hair type' | split: '~' -%}
{%- for j in journeys -%}{%- assign jp = j | split: '|' -%}
<button type="button" class="sf-journey sf-journey-{{ jp[0] }}" data-match-open="{{ jp[0] }}" role="listitem"><span class="sf-journey-icon" aria-hidden="true">{%- case jp[0] -%}{%- when 'base' -%}<svg viewBox="0 0 40 40"><rect x="14" y="6" width="12" height="8" rx="2"/><path d="M11 14h18v18a4 4 0 0 1-4 4H15a4 4 0 0 1-4-4z"/><path d="M15 22h10"/></svg>{%- when 'skin' -%}<svg viewBox="0 0 40 40"><path d="M16 5h8v6l3 4v19a2 2 0 0 1-2 2H15a2 2 0 0 1-2-2V15l3-4z"/><path d="M13 22h14"/></svg>{%- when 'scent' -%}<svg viewBox="0 0 40 40"><rect x="10" y="15" width="20" height="20" rx="5"/><path d="M17 15v-5h6v5M15 7h10"/><circle cx="20" cy="25" r="4"/></svg>{%- when 'lips' -%}<svg viewBox="0 0 40 40"><path d="M5 20c4-6 8-8 11-6 2 1 3 1 4 0 1 1 2 1 4 0 3-2 7 0 11 6-5 7-10 10-15 10S10 27 5 20z"/><path d="M5 20h30"/></svg>{%- else -%}<svg viewBox="0 0 40 40"><path d="M8 34c4-10 4-20 12-28M14 34c3-8 4-17 10-24M20 34c2-7 4-14 9-19"/></svg>{%- endcase -%}</span><span class="sf-journey-text"><strong>{{ jp[1] }}</strong><small>{{ jp[2] }}</small></span>{% render 'sf-icon',name:'arrow' %}</button>
{%- endfor -%}
</div>
</section>
{% schema %}
{"name": "Sofie Find My Match", "settings": [
 {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PERSONALISED BY SOFIE"},
 {"type": "text", "id": "heading", "label": "Heading", "default": "Find My Match"},
 {"type": "textarea", "id": "text", "label": "Text", "default": "Tell us about your skin, tone, finish and budget. We read every product we have in stock and hand-pick your matches — with shades to try and the reasons why."},
 {"type": "text", "id": "button_label", "label": "Button", "default": "Start my match"},
 {"type": "text", "id": "time_label", "label": "Time note", "default": "About 60 seconds"},
 {"type": "text", "id": "resume_label", "label": "Returning visitor link", "default": "See my picks again"}
], "presets": [{"name": "Sofie Find My Match"}]}
{% endschema %}
