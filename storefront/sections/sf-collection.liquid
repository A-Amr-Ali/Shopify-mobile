{% assign is_now=false %}{% if collection.handle == settings.now_collection.handle or collection.handle == 'sofie-hours' or collection.handle == 'sofie-now' %}{% assign is_now=true %}{% endif %}<section class="sf-collection sf-wrap"><nav class="sf-breadcrumb"><a href="{{ routes.root_url }}">{{ 'sf.text.home' | t }}</a><span>/</span><span>{% if is_now %}SOFIE NOW{% else %}{{ collection.title | escape }}{% endif %}</span></nav><div class="sf-collection-heading"><div><p class="eyebrow">{% if is_now %}{{ 'sf.text.now_kicker' | t }}{% else %}THE SOFIE EDIT{% endif %}</p><h1>{% if is_now %}SOFIE <em>NOW</em>{% else %}{{ collection.title | escape }}{% endif %}</h1>{% if is_now %}<p>{{ 'sf.text.now_text' | t }}</p><p class="small">{{ 'sf.text.now_terms' | t }} {% render 'sf-now-hours', mode: 'sentence' %}</p>{% elsif collection.description != blank %}<details class="sf-collection-description"><summary>{{ 'sf.text.read_more' | t }}</summary><div class="rte">{{ collection.description }}</div></details>{% endif %}</div>{% if is_now %}<button class="button button-outline" data-dialog="sf-area">{% render 'sf-icon',name:'pin' %}{{ 'sf.text.area' | t }}</button>{% endif %}</div>
{% paginate collection.products by 24 %}<form class="sf-filter-form" method="get"><div class="sf-collection-toolbar"><details class="sf-filters"><summary>{% render 'sf-icon',name:'filter' %}{{ 'sf.text.filters' | t }}</summary><div class="sf-filters-panel">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label | escape }}</legend>{% case filter.type %}{% when 'boolean','list' %}{% for value in filter.values %}<label class="sf-check"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>{{ value.label | escape }} <span>({{ value.count }})</span></label>{% endfor %}{% when 'price_range' %}<div class="sf-price-range"><label>{{ 'sf.text.min' | t }}<input name="{{ filter.min_value.param_name }}" type="number" min="0" step="any" placeholder="0"{% if filter.min_value.value %} value="{{ filter.min_value.value | divided_by:100.0 }}"{% endif %}></label><label>{{ 'sf.text.max' | t }}<input name="{{ filter.max_value.param_name }}" type="number" min="0" step="any" placeholder="{{ filter.range_max | divided_by:100.0 }}"{% if filter.max_value.value %} value="{{ filter.max_value.value | divided_by:100.0 }}"{% endif %}></label></div>{% endcase %}</fieldset>{% endfor %}<div class="sf-filter-buttons"><button class="button" type="submit">{{ 'sf.text.apply' | t }}</button><a href="{{ collection.url }}" class="underlined">{{ 'sf.text.clear' | t }}</a></div></div></details><span>{{ collection.products_count }} {{ 'sf.text.products' | t }}</span><label class="sf-sort"><span class="sr-only">{{ 'sf.text.sort' | t }}</span><select name="sort_by" data-sort>{% assign sort=collection.sort_by | default:collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort %} selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label><noscript><button type="submit">{{ 'sf.text.apply' | t }}</button></noscript></div></form><div class="sf-active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ filter.label | escape }}: {{ value.label | escape }} ×</a>{% endfor %}{% endfor %}</div><div class="sf-grid">{% for product in collection.products %}{% render 'sf-card',product:product %}{% else %}<p>{{ 'sf.text.no_results' | t }}</p>{% endfor %}</div>{% render 'sf-pagination',paginate:paginate %}{% endpaginate %}</section>
{% schema %}
{"name": "Sofie Collection", "settings": []}
{% endschema %}

