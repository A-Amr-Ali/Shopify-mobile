{%- liquid
  assign hv = product.metafields.custom.how_to_video.value
  assign hv_s = hv | append: ''
  assign hv_id = ''
  if hv_s contains 'youtu.be/'
    assign hv_id = hv_s | split: 'youtu.be/' | last | split: '?' | first | split: '&' | first | split: '/' | first
  elsif hv_s contains '/shorts/'
    assign hv_id = hv_s | split: '/shorts/' | last | split: '?' | first | split: '/' | first
  elsif hv_s contains '/embed/'
    assign hv_id = hv_s | split: '/embed/' | last | split: '?' | first | split: '/' | first
  elsif hv_s contains 'v='
    assign hv_id = hv_s | split: 'v=' | last | split: '&' | first | split: '#' | first
  endif
  assign hv_title = product.metafields.custom.how_to_video_title.value | default: 'How to use it'
  assign hv_credit = product.metafields.custom.how_to_video_credit.value
  assign yt_query = product.vendor | append: ' ' | append: product.title | append: ' how to use' | url_encode
  assign ba = product.metafields.custom.before_after.value
  assign ba_caption = product.metafields.custom.before_after_caption.value
  assign ba_source = product.metafields.custom.before_after_source.value
  assign sr = product.metafields.custom.source_rating.value
-%}
{%- capture ba_items -%}
{%- for img in ba -%}<figure class="sf-ba-item">{{ img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 40vw, 92vw', alt: img.alt }}{%- if img.alt != blank -%}<figcaption>{{ img.alt | escape }}</figcaption>{%- endif -%}</figure>{%- endfor -%}
{%- for media in product.media -%}{%- if media.media_type == 'image' -%}{%- assign probe = media.alt | append: ' ' | append: media.preview_image.src | downcase -%}{%- if probe contains 'before' -%}<figure class="sf-ba-item">{{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 40vw, 92vw', alt: media.alt }}<figcaption>{{ media.alt | default: 'Before and after, as shown by the brand.' | escape }}</figcaption></figure>{%- endif -%}{%- endif -%}{%- endfor -%}
{%- endcapture -%}
<section class="sf-education sf-wrap" data-education><nav class="sf-product-nav" aria-label="{{ 'sf.text.details' | t }}"><a href="#sf-description">{{ 'sf.text.description' | t }}</a><a href="#sf-how-to" data-usage-link hidden>{{ 'sf.text.how_to' | t }}</a><a href="#sf-videos" data-video-link{% if hv_id == blank %} hidden{% endif %}>{{ 'sf.text.video' | t }}</a>{%- if ba_items != blank -%}<a href="#sf-before-after">{{ 'sf.text.before_after' | t }}</a>{%- endif -%}<a href="#sf-reviews">{{ 'sf.text.customer_reviews' | t }}</a></nav>
<div id="sf-how-to" class="sf-content-block" data-usage hidden><p class="eyebrow">THE SOFIE GUIDE</p><h2>{{ 'sf.text.how_to' | t }}</h2><div class="rte" data-usage-content></div></div>
<div id="sf-videos" class="sf-content-block" data-videos{% if hv_id == blank %} hidden{% endif %}><p class="eyebrow">{{ 'sf.text.video_text' | t }}</p><h2>{{ 'sf.text.video' | t }}</h2><div class="sf-video-grid" data-video-grid>{%- if hv_id != blank -%}<article class="sf-video-card is-howto"><button class="sf-video-play" data-video-provider="youtube" data-video-id="{{ hv_id | escape }}" data-video-title="{{ hv_title | escape }}"><img src="https://i.ytimg.com/vi/{{ hv_id | escape }}/hqdefault.jpg" alt="" loading="lazy" decoding="async" width="480" height="360"><span>{% render 'sf-icon',name:'play' %}{{ 'sf.text.watch' | t }}</span></button><p><strong>{{ hv_title | escape }}</strong>{%- if hv_credit != blank -%}<small>{{ hv_credit | escape }} · <a class="underlined" href="{{ hv_s | escape }}" target="_blank" rel="noopener noreferrer">{{ 'sf.text.original' | t }} ↗</a></small>{%- endif -%}</p></article>{%- endif -%}{% for media in product.media %}{% if media.media_type == 'video' %}<article>{{ media | video_tag:controls:true,autoplay:false,loop:false,preload:'none',image_size:'700x' }}<p>{{ media.alt | default:product.title | escape }}</p></article>{% elsif media.media_type == 'external_video' %}<article class="sf-video-card"><button class="sf-video-play" data-video-provider="{{ media.host }}" data-video-id="{{ media.external_id }}" data-video-title="{{ media.alt | default:product.title | escape }}">{{ media.preview_image | image_url:width:700 | image_tag:loading:'lazy',alt:'' }}<span>{% render 'sf-icon',name:'play' %}{{ 'sf.text.watch' | t }}</span></button><p>{{ media.alt | default:product.title | escape }}</p></article>{% endif %}{% endfor %}</div><div class="sf-video-fallback" data-video-fallback hidden><p>See how to apply and use <strong>{{ product.title | escape }}</strong> in tutorials from {{ product.vendor | escape }} and beauty creators.</p><a class="button button-outline" href="https://www.youtube.com/results?search_query={{ yt_query }}" target="_blank" rel="noopener noreferrer">{% render 'sf-icon',name:'play' %}Watch tutorials on YouTube ↗</a></div></div>
<details id="sf-description" class="sf-description sf-content-block" open><summary><h2>{{ 'sf.text.description' | t }}</h2></summary><div class="rte" data-description>{% render 'sf-description',product:product %}</div></details>
{%- if ba_items != blank -%}<div id="sf-before-after" class="sf-content-block sf-ba"><p class="eyebrow">REAL RESULTS</p><h2>{{ 'sf.text.before_after' | t }}</h2>{%- if ba_caption != blank -%}<p class="sf-ba-lead">{{ ba_caption | escape | newline_to_br }}</p>{%- endif -%}<div class="sf-ba-grid">{{ ba_items }}</div><p class="small">{{ 'sf.text.results_note' | t }}{% if ba_source != blank %} <a class="underlined" href="{{ ba_source }}" target="_blank" rel="noopener noreferrer">{{ 'sf.text.source' | t }} ↗</a>{% endif %}</p></div>{%- endif -%}
{% for block in section.blocks %}{% if block.settings.product.id == product.id %}{% case block.type %}{% when 'source' %}<div class="sf-external-review sf-content-block" {{ block.shopify_attributes }}><div><p class="eyebrow">{{ 'sf.text.external_reviews' | t }}</p><h2>{{ block.settings.source_name | escape }}</h2><p>{{ block.settings.summary | escape }}</p><a class="underlined" href="{{ block.settings.url }}" target="_blank" rel="noopener noreferrer">{{ 'sf.text.read_reviews' | t }} ↗</a><p class="small">{{ 'sf.text.checked' | t }}: {{ block.settings.checked | escape }}. {{ 'sf.text.source_note' | t }}</p></div><blockquote>{{ block.settings.excerpt | escape }}<cite>{{ block.settings.author | escape }}</cite></blockquote></div>{% when 'video' %}<div class="sf-content-block" {{ block.shopify_attributes }}><h2>{{ block.settings.title | escape }}</h2><div class="sf-video-card"><button class="sf-video-play" data-video-provider="{{ block.settings.video.type }}" data-video-id="{{ block.settings.video.id }}" data-video-title="{{ block.settings.title | escape }}">{% if block.settings.poster %}{{ block.settings.poster | image_url:width:900 | image_tag:loading:'lazy',alt:'' }}{% endif %}<span>{% render 'sf-icon',name:'play' %}{{ 'sf.text.watch' | t }}</span></button></div><p class="small">{{ block.settings.credit | escape }} <a class="underlined" href="{{ block.settings.video }}" target="_blank" rel="noopener noreferrer">{{ 'sf.text.original' | t }} ↗</a></p></div>{% when 'result' %}<div class="sf-content-block" {{ block.shopify_attributes }}><h2>{{ 'sf.text.before_after' | t }}</h2>{{ block.settings.image | image_url:width:1100 | image_tag:loading:'lazy',alt:block.settings.caption }}<p>{{ block.settings.caption | escape }}</p><p class="small">{{ 'sf.text.results_note' | t }} <a href="{{ block.settings.url }}" class="underlined" target="_blank" rel="noopener">{{ 'sf.text.source' | t }} ↗</a></p></div>{% endcase %}{% endif %}{% endfor %}
{%- if sr.rating != blank -%}<div id="sf-source-rating" class="sf-content-block sf-source-rating"><p class="eyebrow">{{ 'sf.text.source_rating' | t }}</p><div class="sf-sr-row"><span class="sf-stars" style="--r:{{ sr.rating }}" aria-hidden="true"></span><strong>{{ sr.rating }}</strong><span>/ 5{% if sr.count != blank %} from {{ sr.count }} ratings{% endif %} on {{ sr.source | escape }}</span></div><p class="small">{{ 'sf.text.source_note' | t }}{% if sr.checked != blank %} {{ 'sf.text.checked' | t }}: {{ sr.checked | escape }}.{% endif %} {% if sr.url != blank %}<a class="underlined" href="{{ sr.url }}" target="_blank" rel="noopener noreferrer">{{ 'sf.text.read_reviews' | t }} ↗</a>{% endif %}</p></div>{%- endif -%}
<div id="sf-reviews" class="sf-content-block"><p class="eyebrow">VERIFIED SOFIE CUSTOMERS</p><h2>{{ 'sf.text.customer_reviews' | t }}</h2>{% if product.metafields.judgeme.widget != blank %}<div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>{% else %}{%- assign lx_n = product.metafields.loox.num_reviews | plus: 0 -%}{%- if lx_n == 0 -%}<p class="sf-reviews-empty">No SOFIE customer reviews for this product yet. Reviews from verified SOFIE customers will appear here.</p>{%- endif -%}<div id="looxReviews" data-product-id="{{ product.id }}" class="loox-reviews-default">{{ product.metafields.loox.reviews }}</div>{% endif %}</div>
</section>
{% schema %}
{"name": "Sofie Education", "settings": [], "blocks": [{"type": "source", "name": "External review source", "settings": [{"type": "product", "id": "product", "label": "Exact product"}, {"type": "text", "id": "source_name", "label": "Source name"}, {"type": "url", "id": "url", "label": "Source URL"}, {"type": "text", "id": "checked", "label": "Date checked"}, {"type": "textarea", "id": "summary", "label": "Source summary"}, {"type": "textarea", "id": "excerpt", "label": "Short verified excerpt"}, {"type": "text", "id": "author", "label": "Reviewer and attribution"}]}, {"type": "video", "name": "Product tutorial", "settings": [{"type": "product", "id": "product", "label": "Exact product"}, {"type": "video_url", "id": "video", "label": "Official or permitted video", "accept": ["youtube", "vimeo"]}, {"type": "image_picker", "id": "poster", "label": "Poster"}, {"type": "text", "id": "title", "label": "Video title"}, {"type": "text", "id": "credit", "label": "Creator / source"}]}, {"type": "result", "name": "Sourced before and after", "settings": [{"type": "product", "id": "product", "label": "Exact product"}, {"type": "image_picker", "id": "image", "label": "Image with reuse rights"}, {"type": "textarea", "id": "caption", "label": "Source and context"}, {"type": "url", "id": "url", "label": "Source URL"}]}]}
{% endschema %}

