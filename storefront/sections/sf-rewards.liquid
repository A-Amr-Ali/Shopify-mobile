<section class="sfr-hub sf-wrap" data-rewards-hub data-proxy="{{ routes.root_url }}apps/loyalty" data-root="{{ routes.root_url }}" data-locale="{{ request.locale.iso_code }}">
  <header class="sfr-hero"><p class="eyebrow">SOFIE REWARDS</p><h1>{{ 'sf.rewards.title' | t }}</h1><p>{{ 'sf.rewards.intro' | t }}</p><a class="underlined" href="#sfr-how">{{ 'sf.rewards.how' | t }}</a></header>
  {% if customer %}
  <div class="sfr-grid">
    <section class="sfr-card sfr-member" aria-labelledby="sfr-member-title"><p class="eyebrow" id="sfr-member-title">{{ 'sf.rewards.your_membership' | t }}</p><h2 data-member-tier>SOFIE</h2><p class="sfr-balance"><span data-rewards-balance>—</span> <small>{{ 'sf.rewards.points' | t }}</small></p><p data-tier-progress>{{ 'sf.rewards.loading' | t }}</p><progress data-tier-bar max="100" value="0" aria-label="{{ 'sf.rewards.tier_progress' | t }}"></progress><p class="sfr-member-number">{{ 'sf.rewards.member_number' | t }}<br><strong data-member-id>{{ customer.id }}</strong></p><p>{{ 'sf.rewards.member_store' | t }}</p></section>
    <section class="sfr-card" id="sfr-redeem"><p class="eyebrow">{{ 'sf.rewards.redeem' | t }}</p><h2>{{ 'sf.rewards.choose_reward' | t }}</h2><p>{{ 'sf.rewards.redeem_note' | t }}</p><div class="sfr-reward-options" data-reward-options></div><details><summary>{{ 'sf.rewards.in_store' | t }}</summary><p>{{ 'sf.rewards.store_steps' | t }}</p><a class="underlined" href="#sfr-member-title">{{ 'sf.rewards.show_card' | t }}</a></details></section>
    <section class="sfr-card sfr-birthday"><p class="eyebrow">{{ 'sf.rewards.birthday' | t }}</p><h2>{{ 'sf.rewards.birthday_title' | t }}</h2><p>{{ 'sf.rewards.birthday_intro' | t }}</p><div data-birthday-status></div><form data-birthday-form><div class="sfr-date"><label>{{ 'sf.rewards.month' | t }}<select name="month" required><option value="">—</option>{% for m in (1..12) %}<option value="{{ m }}">{{ m }}</option>{% endfor %}</select></label><label>{{ 'sf.rewards.day' | t }}<input name="day" type="number" min="1" max="31" required inputmode="numeric"></label></div><label class="sfr-consent"><input name="consent" type="checkbox" required><span>{{ 'sf.rewards.birthday_consent' | t }}</span></label><button class="button" type="submit">{{ 'sf.rewards.save_birthday' | t }}</button></form><button class="sfr-link" type="button" data-birthday-opt-out hidden>{{ 'sf.rewards.opt_out' | t }}</button><p class="sfr-small">{{ 'sf.rewards.birthday_terms' | t }} <a href="{{ routes.root_url }}pages/contact">{{ 'sf.rewards.correct_birthday' | t }}</a></p></section>
    <section class="sfr-card"><p class="eyebrow">{{ 'sf.rewards.wallet' | t }}</p><h2>{{ 'sf.rewards.ready_rewards' | t }}</h2><div data-reward-wallet><p>{{ 'sf.rewards.loading' | t }}</p></div><a class="underlined" href="{{ routes.root_url }}pages/beauty-passport">{{ 'sf.rewards.beauty_passport' | t }}</a></section>
  </div>
  <p class="sfr-message" data-rewards-message role="status" aria-live="polite"></p>
  <details class="sfr-activity"><summary>{{ 'sf.rewards.activity' | t }}</summary><div data-rewards-activity></div></details>
  {% else %}
  <div class="sfr-guest"><h2>{{ 'sf.rewards.join_title' | t }}</h2><p>{{ 'sf.rewards.join_text' | t }}</p><a class="button" href="{{ routes.account_login_url }}?return_url={{ '/pages/my-rewards' | url_encode }}">{{ 'sf.rewards.join' | t }}</a></div>
  {% endif %}
  <section class="sfr-how" id="sfr-how"><p class="eyebrow">{{ 'sf.rewards.how' | t }}</p><h2>{{ 'sf.rewards.one_account' | t }}</h2><div class="sfr-steps"><article><span>01</span><h3>{{ 'sf.rewards.earn' | t }}</h3><p>{{ 'sf.rewards.earn_text' | t }}</p></article><article><span>02</span><h3>{{ 'sf.rewards.unlock' | t }}</h3><p>{{ 'sf.rewards.unlock_text' | t }}</p></article><article><span>03</span><h3>{{ 'sf.rewards.celebrate' | t }}</h3><p>{{ 'sf.rewards.celebrate_text' | t }}</p></article></div></section>
  <div class="sfr-table-wrap"><table><caption>{{ 'sf.rewards.tiers' | t }}</caption><thead><tr><th>{{ 'sf.rewards.benefit' | t }}</th><th>Insider</th><th>VIP</th><th>Icon</th></tr></thead><tbody><tr><th>{{ 'sf.rewards.qualification' | t }}</th><td>{{ 'sf.rewards.free' | t }}</td><td>40,000 EGP</td><td>120,000 EGP</td></tr><tr><th>{{ 'sf.rewards.earn_multiplier' | t }}</th><td>1×</td><td>1.25×</td><td>1.5×</td></tr><tr><th>{{ 'sf.rewards.birthday_credit' | t }}</th><td>50 EGP</td><td>300 EGP</td><td>750 EGP</td></tr><tr><th>{{ 'sf.rewards.birthday_month' | t }}</th><td>1×</td><td>2.5×</td><td>3×</td></tr><tr><th>{{ 'sf.rewards.both_channels' | t }}</th><td>✓</td><td>✓</td><td>✓</td></tr></tbody></table></div>
  <details class="sfr-terms"><summary>{{ 'sf.rewards.terms_title' | t }}</summary><p>{{ 'sf.rewards.terms' | t }}</p><p>{{ 'sf.rewards.extras' | t }}</p></details>
  <script type="application/json" data-rewards-strings>{
  "email_required":{{ 'sf.rewards.email_required' | t | json }},"loading":{{ 'sf.rewards.loading' | t | json }},"error":{{ 'sf.rewards.error' | t | json }},"points":{{ 'sf.rewards.points' | t | json }},"off":{{ 'sf.rewards.off' | t | json }},"redeem_online":{{ 'sf.rewards.redeem_online' | t | json }},"next_tier":{{ 'sf.rewards.next_tier' | t | json }},"top_tier":{{ 'sf.rewards.top_tier' | t | json }},"birthday_saved":{{ 'sf.rewards.birthday_saved' | t | json }},"birthday_ready":{{ 'sf.rewards.birthday_ready' | t | json }},"birthday_online":{{ 'sf.rewards.birthday_online' | t | json }},"birthday_used":{{ 'sf.rewards.birthday_used' | t | json }},"saved":{{ 'sf.rewards.saved' | t | json }},"birthday_locked":{{ 'sf.rewards.birthday_locked' | t | json }},"invalid_birthday":{{ 'sf.rewards.invalid_birthday' | t | json }},"no_rewards":{{ 'sf.rewards.no_rewards' | t | json }},"apply_code":{{ 'sf.rewards.apply_code' | t | json }},"copy":{{ 'sf.rewards.copy' | t | json }},"copied":{{ 'sf.rewards.copied' | t | json }},"online_code":{{ 'sf.rewards.online_code' | t | json }},"store_reward":{{ 'sf.rewards.store_reward' | t | json }},"pending":{{ 'sf.rewards.pending' | t | json }},"retry":{{ 'sf.rewards.retry' | t | json }},"expires":{{ 'sf.rewards.expires' | t | json }},"insufficient_points":{{ 'sf.rewards.insufficient_points' | t | json }},"birthday_already_claimed":{{ 'sf.rewards.birthday_already_claimed' | t | json }},"confirm_redeem":{{ 'sf.rewards.confirm_redeem' | t | json }},"birthday_opted_out":{{ 'sf.rewards.birthday_opted_out' | t | json }}
  }</script>
</section>
{{ 'sofie-rewards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sofie-rewards.js' | asset_url }}" defer></script>
{% schema %}
{"name":"SOFIE Rewards","settings":[],"presets":[{"name":"SOFIE Rewards"}]}
{% endschema %}
