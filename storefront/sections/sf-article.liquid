<article class="sf-section sf-wrap sf-page"><a class="underlined" href="{{ blog.url }}">{{ blog.title | escape }}</a><h1>{{ article.title | escape }}</h1><p class="eyebrow">{{ article.published_at | date:'%d %B %Y' }} · {{ article.author | escape }}</p>{% if article.image %}{{ article.image | image_url:width:1200 | image_tag:loading:'eager',alt:article.title }}{% endif %}<div class="rte">{{ article.content }}</div>{% if blog.comments_enabled? %}{% paginate article.comments by 10 %}{% for comment in article.comments %}<blockquote>{{ comment.content }}<cite>{{ comment.author | escape }}</cite></blockquote>{% endfor %}{% render 'sf-pagination',paginate:paginate %}{% endpaginate %}{% form 'new_comment',article %}{{ form.errors | default_errors }}<label for="comment-name">{{ 'sf.text.name' | t }}</label><input id="comment-name" name="comment[author]" required><label for="comment-email">{{ 'sf.text.email' | t }}</label><input id="comment-email" name="comment[email]" type="email" required><label for="comment-body">{{ 'sf.text.message' | t }}</label><textarea id="comment-body" name="comment[body]" required></textarea><button class="button">{{ 'sf.text.send' | t }}</button>{% endform %}{% endif %}<script type="application/ld+json">{{ article | structured_data }}</script></article>
{% schema %}
{"name": "Sofie Article", "settings": []}
{% endschema %}

