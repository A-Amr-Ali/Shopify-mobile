<section class="sf-section sf-wrap sf-customer">
{% case request.page_type %}
{% when 'customers/login' %}<h1>{{ 'sf.text.sign_in' | t }}</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label for="login-email">{{ 'sf.text.email' | t }}</label><input id="login-email" name="customer[email]" type="email" autocomplete="email" required><label for="login-password">{{ 'sf.text.password' | t }}</label><input id="login-password" name="customer[password]" type="password" autocomplete="current-password" required><button class="button">{{ 'sf.text.sign_in' | t }}</button><a class="underlined" href="{{ routes.account_register_url }}">{{ 'sf.text.register' | t }}</a>{% endform %}<details id="recover"><summary>{{ 'sf.text.forgot' | t }}</summary>{% form 'recover_customer_password' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'sf.text.recover_sent' | t }}</p>{% endif %}<label for="recover-email">{{ 'sf.text.email' | t }}</label><input id="recover-email" name="email" type="email" autocomplete="email" required><button class="button">{{ 'sf.text.recover' | t }}</button>{% endform %}</details>
{% when 'customers/register' %}<h1>{{ 'sf.text.register' | t }}</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label for="reg-first">{{ 'sf.text.first_name' | t }}</label><input id="reg-first" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name | escape }}"><label for="reg-last">{{ 'sf.text.last_name' | t }}</label><input id="reg-last" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name | escape }}"><label for="reg-email">{{ 'sf.text.email' | t }}</label><input id="reg-email" name="customer[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required><label for="reg-password">{{ 'sf.text.password' | t }}</label><input id="reg-password" name="customer[password]" type="password" autocomplete="new-password" required><button class="button">{{ 'sf.text.register' | t }}</button>{% endform %}
{% when 'customers/reset_password' %}<h1>{{ 'sf.text.reset' | t }}</h1>{% form 'reset_customer_password' %}{{ form.errors | default_errors }}<label for="reset-password">{{ 'sf.text.password' | t }}</label><input id="reset-password" name="customer[password]" type="password" autocomplete="new-password" required><label for="reset-confirm">{{ 'sf.text.confirm_password' | t }}</label><input id="reset-confirm" name="customer[password_confirmation]" type="password" autocomplete="new-password" required><button class="button">{{ 'sf.text.reset' | t }}</button>{% endform %}
{% when 'customers/activate_account' %}<h1>{{ 'sf.text.activate' | t }}</h1>{% form 'activate_customer_password' %}{{ form.errors | default_errors }}<label for="activate-password">{{ 'sf.text.password' | t }}</label><input id="activate-password" name="customer[password]" type="password" autocomplete="new-password" required><label for="activate-confirm">{{ 'sf.text.confirm_password' | t }}</label><input id="activate-confirm" name="customer[password_confirmation]" type="password" autocomplete="new-password" required><button class="button">{{ 'sf.text.activate' | t }}</button>{% endform %}
{% when 'customers/account' %}<h1>{{ 'sf.text.account' | t }}</h1><p>{{ customer.name | escape }}</p><a class="underlined" href="{{ routes.account_logout_url }}">{{ 'sf.text.sign_out' | t }}</a><h2>{{ 'sf.text.orders' | t }}</h2>{% paginate customer.orders by 20 %}{% if customer.orders.size > 0 %}<table><thead><tr><th>{{ 'sf.text.order' | t }}</th><th>{{ 'sf.text.date' | t }}</th><th>{{ 'sf.text.payment' | t }}</th><th>{{ 'sf.text.fulfillment' | t }}</th><th>{{ 'sf.text.total' | t }}</th></tr></thead><tbody>{% for order in customer.orders %}<tr><td><a class="underlined" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date:'%d %b %Y' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>{{ 'sf.text.no_orders' | t }}</p>{% endif %}{% render 'sf-pagination',paginate:paginate %}{% endpaginate %}<h2>{{ 'sf.text.addresses' | t }}</h2>{{ customer.default_address | format_address }}<a class="button button-outline" href="{{ routes.account_addresses_url }}">{{ 'sf.text.addresses' | t }}</a>
{% when 'customers/order' %}<a class="underlined" href="{{ routes.account_url }}">{{ 'sf.text.account' | t }}</a><h1>{{ 'sf.text.order' | t }} {{ order.name }}</h1><p>{{ order.created_at | date:'%d %B %Y' }}</p><p>{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p><table><thead><tr><th>{{ 'sf.text.details' | t }}</th><th>{{ 'sf.text.quantity' | t }}</th><th>{{ 'sf.text.total' | t }}</th></tr></thead><tbody>{% for item in order.line_items %}<tr><td><a href="{{ item.product.url }}">{{ item.title | escape }}</a>{% if item.fulfillment.tracking_url %}<a href="{{ item.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ item.fulfillment.tracking_number | escape }}</a>{% endif %}</td><td>{{ item.quantity }}</td><td>{{ item.final_line_price | money }}</td></tr>{% endfor %}</tbody></table><p>{{ 'sf.text.total' | t }}: {{ order.total_net_amount | money_with_currency }}</p><h2>{{ 'sf.text.billing' | t }}</h2>{{ order.billing_address | format_address }}<h2>{{ 'sf.text.shipping_address' | t }}</h2>{{ order.shipping_address | format_address }}
{% when 'customers/addresses' %}<h1>{{ 'sf.text.addresses' | t }}</h1><a href="{{ routes.account_url }}" class="underlined">{{ 'sf.text.account' | t }}</a>{% paginate customer.addresses by 10 %}{% for address in customer.addresses %}<article>{{ address | format_address }}<details><summary>{{ 'sf.text.address_edit' | t }}</summary>{% form 'customer_address',address %}{{ form.errors | default_errors }}{% render 'sf-address-fields',form:form,id:address.id %}<button class="button">{{ 'sf.text.save_changes' | t }}</button>{% endform %}</details><form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" data-delete-address><input type="hidden" name="_method" value="delete"><button class="underlined">{{ 'sf.text.address_delete' | t }}</button></form></article>{% endfor %}{% render 'sf-pagination',paginate:paginate %}{% endpaginate %}<details><summary>{{ 'sf.text.address_add' | t }}</summary>{% form 'customer_address',customer.new_address %}{{ form.errors | default_errors }}{% render 'sf-address-fields',form:form,id:'new' %}<button class="button">{{ 'sf.text.address_add' | t }}</button>{% endform %}</details>
{% endcase %}</section>
{% schema %}{"name":"SOFIE account","settings":[]}{% endschema %}

