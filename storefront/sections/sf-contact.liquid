<section class="sf-section sf-wrap sf-contact"><h1>{{ page.title | default:shop.name | escape }}</h1><div class="rte">{{ page.content }}</div><div class="sf-contact-grid"><div><h2>{{ 'sf.text.help' | t }}</h2><p>{{ 'sf.text.product_help' | t }}</p><a class="button button-outline" href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">{{ 'sf.text.ask' | t }} ↗</a><p>{{ 'sf.text.stores' | t }}</p></div>{% form 'contact' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'sf.text.sent' | t }}</p>{% else %}<label for="contact-name">{{ 'sf.text.name' | t }}</label><input id="contact-name" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required><label for="contact-email">{{ 'sf.text.email' | t }}</label><input id="contact-email" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required><label for="contact-phone">{{ 'sf.text.phone' | t }}</label><input id="contact-phone" name="contact[phone]" type="tel" autocomplete="tel"><label for="contact-message">{{ 'sf.text.message' | t }}</label><textarea id="contact-message" name="contact[body]" required>{{ form.body | escape }}</textarea><button class="button">{{ 'sf.text.send' | t }}</button>{% endif %}{% endform %}</div></section>
{% schema %}
{"name": "Sofie Contact", "settings": []}
{% endschema %}

