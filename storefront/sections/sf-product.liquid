{% assign v=product.selected_or_first_available_variant %}<section class="sf-product sf-wrap" data-product data-product-id="{{ product.id }}" data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-url="{{ product.url }}" data-whatsapp="{{ settings.whatsapp }}">
<nav class="sf-breadcrumb" aria-label="{{ 'sf.text.menu' | t }}"><a href="{{ routes.root_url }}">{{ 'sf.text.home' | t }}</a><span>/</span><a href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}">{{ product.vendor | escape }}</a><span>/</span><span>{{ product.title | escape }}</span></nav>
<div class="sf-pdp-grid"><div class="sf-gallery"><div class="sf-gallery-main">{% assign hero=v.featured_image | default:product.featured_image %}{% if hero %}<a href="{{ hero | image_url:width:2000 }}" data-zoom target="_blank" rel="noopener" aria-label="{{ 'sf.text.zoom' | t }}">{{ hero | image_url:width:1200 | image_tag: widths:'400,600,900,1200',sizes:'(min-width: 900px) 50vw,100vw',loading:'eager',fetchpriority:'high',alt:product.title,id:'sf-product-image' }}</a>{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}<button class="sf-save icon-button" data-save="{{ product.handle }}" data-title="{{ product.title | escape }}" data-image="{{ hero | image_url:width:180 }}" data-url="{{ product.url }}" aria-label="{{ 'sf.text.save' | t }}" aria-pressed="false">{% render 'sf-icon',name:'heart' %}</button></div><div class="sf-thumbs">{% for media in product.media %}{% if media.media_type == 'image' %}<button class="sf-thumb" data-gallery="{{ media | image_url:width:1200 }}" data-original="{{ media | image_url:width:2000 }}" data-alt="{{ media.alt | default:product.title | escape }}" aria-label="{{ 'sf.text.view_image' | t }} {{ forloop.index }}" aria-pressed="{% if media.id == hero.id %}true{% else %}false{% endif %}">{{ media | image_url:width:150 | image_tag:loading:'lazy',alt:'' }}</button>{% endif %}{% endfor %}</div></div>
<div class="sf-pdp-info"><a class="sf-vendor" href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}">{{ product.vendor | escape }}</a><h1>{{ product.title | escape }}</h1>{%- liquid
  assign lx_avg = product.metafields.loox.avg_rating
  assign lx_num = product.metafields.loox.num_reviews | plus: 0
  assign src_rating = product.metafields.custom.source_rating.value
-%}{%- if lx_num > 0 -%}<a class="sf-rating-line" href="#sf-reviews"><span class="sf-stars" style="--r:{{ lx_avg }}" aria-hidden="true"></span>{{ lx_avg }} · {{ lx_num }} {% if lx_num == 1 %}review{% else %}reviews{% endif %}</a>{%- elsif src_rating.rating != blank -%}<a class="sf-rating-line is-source" href="#sf-source-rating"><span class="sf-stars" style="--r:{{ src_rating.rating }}" aria-hidden="true"></span>{{ src_rating.rating }}/5 on {{ src_rating.source | escape }}{% if src_rating.count != blank %} · {{ src_rating.count }} ratings{% endif %}</a>{%- endif -%}<div class="sf-pdp-price"><span data-product-price>{{ v.price | money }}</span><s data-compare-price{% unless v.compare_at_price > v.price %} hidden{% endunless %}>{{ v.compare_at_price | money }}</s></div><p class="sf-pdp-intro" data-product-intro>{{ product.description | strip_html | truncatewords:32 }}</p>
{% form 'product',product,id:'sf-product-form',data-product-form:'' %}{{ form.errors | default_errors }}<div class="sf-product-options"{% if product.has_only_default_variant %} hidden{% endif %}><label for="sf-variant">{{ product.options | join:' / ' | escape }}</label><select name="id" id="sf-variant" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == v.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — {{ 'sf.text.sold_out' | t }}{% endunless %}</option>{% endfor %}</select></div>{% if product.selling_plan_groups.size > 0 %}<label for="sf-selling-plan">{{ 'sf.text.options' | t }}</label><select name="selling_plan" id="sf-selling-plan">{% unless product.requires_selling_plan %}<option value="">{{ 'sf.text.available' | t }}</option>{% endunless %}{% for group in product.selling_plan_groups %}{% for plan in group.selling_plans %}<option value="{{ plan.id }}">{{ plan.name | escape }}</option>{% endfor %}{% endfor %}</select>{% endif %}{% for block in section.blocks %}{% if block.type == 'property' %}<div {{ block.shopify_attributes }}><label for="property-{{ block.id }}">{{ block.settings.label | escape }}</label><input id="property-{{ block.id }}" type="text" name="properties[{{ block.settings.label | escape }}]"{% if block.settings.required %} required{% endif %}></div>{% endif %}{% endfor %}<div class="sf-buy-row"><label class="sr-only" for="sf-quantity">{{ 'sf.text.quantity' | t }}</label><input id="sf-quantity" name="quantity" type="number" value="{{ v.quantity_rule.min | default:1 }}" min="{{ v.quantity_rule.min | default:1 }}" step="{{ v.quantity_rule.increment | default:1 }}"{% if v.quantity_rule.max %} max="{{ v.quantity_rule.max }}"{% endif %}><button type="submit" class="button" data-add-button{% unless v.available %} disabled{% endunless %}>{% if v.available %}{{ 'sf.text.add' | t }}{% else %}{{ 'sf.text.sold_out' | t }}{% endif %} {% render 'sf-icon',name:'plus' %}</button></div><p class="sf-form-error" role="alert" data-form-error hidden></p>{% endform %}
<div class="sfjp-product"><button type="button" data-passport-product>{{ 'sf.journey.save_option' | t }}</button><a href="{{ routes.root_url }}pages/beauty-passport">{{ 'sf.journey.passport' | t }}</a><a href="{{ pages['sofie-knows'].url }}?resume=passport">{{ 'sf.journey.edit_routine' | t }}</a></div><p class="sf-small-assurance">{% render 'sf-icon',name:'check' %}{{ 'sf.text.authentic' | t }} <span>·</span> {{ 'sf.text.secure' | t }}</p>
{% render 'sf-now-product',product:product %}<a class="sf-pdp-help" href="https://wa.me/{{ settings.whatsapp }}?text={{ product.title | url_encode }}" target="_blank" rel="noopener">{{ 'sf.text.stock_help' | t }} <u>{{ 'sf.text.ask' | t }}</u></a>
<details class="sf-policy-accordion"><summary>{{ 'sf.text.delivery' | t }}</summary><p>{{ 'sf.text.standard_text' | t }}</p><a href="{{ pages['shipping-policy'].url | default:shop.shipping_policy.url }}">{{ 'sf.text.shipping' | t }}</a>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">{{ 'sf.text.returns' | t }}</a>{% endif %}</details>
</div></div><div class="sf-sticky-buy"><span><strong>{{ product.vendor | escape }}</strong><span data-sticky-price>{{ v.price | money }}</span></span><button class="button" data-sticky-add{% unless v.available %} disabled{% endunless %}>{{ 'sf.text.add' | t }}</button></div>
<script type="application/json" data-variants>[{% for variant in product.variants %}{"id":{{ variant.id | json }},"title":{{ variant.title | json }},"price":{{ variant.price | json }},"compare":{{ variant.compare_at_price | json }},"available":{{ variant.available | json }},"image":{% if variant.featured_image %}{{ variant.featured_image | image_url:width:1200 | json }}{% else %}null{% endif %},"min":{{ variant.quantity_rule.min | default:1 }},"step":{{ variant.quantity_rule.increment | default:1 }},"max":{{ variant.quantity_rule.max | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script><script type="application/ld+json">{{ product | structured_data }}</script>
</section>
{% schema %}
{"name": "Sofie Product", "settings": [], "blocks": [{"type": "property", "name": "Personalisation", "settings": [{"type": "text", "id": "label", "label": "Label"}, {"type": "checkbox", "id": "required", "label": "Required", "default": false}]}]}
{% endschema %}

