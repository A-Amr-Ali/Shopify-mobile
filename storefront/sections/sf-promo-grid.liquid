<section class="sf-section sf-promos sf-wrap">
{%- if section.settings.heading != blank -%}<div class="sf-section-head"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div>{%- endif -%}
<div class="sf-promo-grid sf-promo-{{ section.blocks.size | at_most: 4 }}">
{%- for block in section.blocks -%}
{%- assign b = block.settings -%}
<a class="sf-promo sf-tone-{{ b.tone }}" href="{{ b.link | default: b.collection.url | default: '#' }}" {{ block.shopify_attributes }}>
<div class="sf-promo-media">
{%- if b.image != blank -%}{{ b.image | image_url: width: 1200 | image_tag: widths: '400,600,800,1000,1200', sizes: '(min-width: 900px) 33vw, 92vw', loading: 'lazy', alt: b.heading }}
{%- elsif b.collection != blank -%}<div class="sf-collage" data-collage="{{ b.collection.url }}?view=sfb" data-collage-kind="promo"></div>
{%- endif -%}
</div>
<div class="sf-promo-copy">{%- if b.eyebrow != blank -%}<p class="eyebrow">{{ b.eyebrow | escape }}</p>{%- endif -%}<h3>{{ b.heading | escape }}</h3>{%- if b.text != blank -%}<p>{{ b.text | escape }}</p>{%- endif -%}<span class="underlined">{{ b.cta | default: 'Shop now' | escape }} {% render 'sf-icon',name:'arrow' %}</span></div>
</a>
{%- endfor -%}
</div>
</section>
{% schema %}
{"name": "Sofie Promo Banners", "settings": [
 {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
 {"type": "text", "id": "heading", "label": "Heading"}
], "blocks": [{"type": "promo", "name": "Banner", "settings": [
 {"type": "select", "id": "tone", "label": "Colour story", "default": "cream", "options": [{"value": "cream", "label": "Cream"}, {"value": "now", "label": "SOFIE NOW rose"}, {"value": "ink", "label": "Ink"}, {"value": "blush", "label": "Blush"}, {"value": "linen", "label": "Linen (home)"}, {"value": "sage", "label": "Sage (home)"}]},
 {"type": "image_picker", "id": "image", "label": "Image"},
 {"type": "collection", "id": "collection", "label": "Collection", "info": "Used for the link and, without an image, a three-product collage."},
 {"type": "url", "id": "link", "label": "Custom link"},
 {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
 {"type": "text", "id": "heading", "label": "Heading", "default": "Banner heading"},
 {"type": "textarea", "id": "text", "label": "Text"},
 {"type": "text", "id": "cta", "label": "Call to action", "default": "Shop now"}
]}], "presets": [{"name": "Sofie Promo Banners", "blocks": [{"type": "promo"}, {"type": "promo"}]}]}
{% endschema %}

